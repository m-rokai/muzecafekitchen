# Gmail SMTP via Google Workspace mailbox
# 1. Sign into the sender mailbox (e.g. notifications@muzeoffice.com)
# 2. Enable 2-Step Verification at https://myaccount.google.com/security
# 3. Generate an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=notifications@yourdomain.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_FROM_NAME=Muze Cafe

# Cafe name shown in email body / subject (optional)
CAFE_NAME=Muze Café

# Staff JWT signing secret. Required in production and must be a random value
# of at least 32 characters. There is no committed production fallback.
# JWT_SECRET=generate-a-random-32-character-or-longer-secret

# Cross-origin browser clients. In production, only these exact origins (plus
# requests without an Origin, such as same-origin/non-browser calls) are
# allowed. Use a comma-separated list; malformed entries are ignored safely.
# CLIENT_URL=https://orders.example.com
# CORS_ALLOWED_ORIGINS=https://orders.example.com,https://staff.example.com

# Temporary local/test bootstrap only. Production staff credentials must be
# stored/configured through the normal admin credential process; this value is
# ignored in production. There is no default PIN.
# INITIAL_ADMIN_PIN=2468

# Customer identity boundary
# Production must be wired to a verified upstream subject (for example a
# Cloudflare Access/OIDC gateway). Do not accept arbitrary client headers in
# production. For local development/tests only:
# NODE_ENV=development
# CUSTOMER_AUTH_MODE=dev-header
# The client sends X-Dev-Customer-Subject when VITE_CUSTOMER_AUTH_MODE=dev-header.
CUSTOMER_AUTH_MODE=required
# Shared secret used only when a trusted gateway injects X-Verified-Subject.
# CUSTOMER_AUTH_MODE=trusted-proxy
# CUSTOMER_AUTH_PROXY_SECRET=replace-with-gateway-secret

# In production, the future edge/gateway must validate Cloudflare Access/OIDC,
# strip inbound identity headers, then inject X-Verified-Subject plus the
# shared X-Auth-Proxy-Secret. The origin remains fail-closed until that trusted
# proxy or an app customerAuthResolver is configured.

# Payment activation is intentionally disabled in revival/core. The adapter
# skeleton supports these names for future work, but no live calls are made.
# PAYMENT_PROVIDER=square
# PAYMENT_PROVIDER=stripe
