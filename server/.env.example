NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://preview.example.com

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-or-hosted-secret-key
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_POOL_SIZE=3

CRON_SECRET=replace-with-at-least-32-random-characters

# Café checkout (Square sandbox by default).
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://localhost:3001/api/webhooks/square

# Partner-meal checkout (Stripe test mode during development).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Weekly partner menu import. The host must exactly match the URL hostname.
PARTNER_MENU_URL=
PARTNER_MENU_ALLOWED_HOST=
PARTNER_SLUG=weekly-partner
PARTNER_NAME=Weekly Meal Partner
PARTNER_MENU_SECTIONS=Land & Sea,Vegetarian
# Leave false until the source-specific parser has been verified in Preview.
PARTNER_MENU_AUTO_PUBLISH=false

GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Muze Cafe
CAFE_NAME=Muze Office

# Used only by `npm run staff:create`.
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_ROLE=admin
