NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://preview.example.com

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-or-hosted-secret-key
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_POOL_SIZE=3

CRON_SECRET=replace-with-at-least-32-random-characters

# Café checkout (Square sandbox by default).
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://localhost:3001/api/webhooks/square

GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Muze Cafe
CAFE_NAME=Muze Office

# Used only by `npm run staff:create`.
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_ROLE=admin
